# Required
OPENAI_API_KEY=your_openai_key_here
ELEVENLABS_API_KEY=your_elevenlabs_key_here   # TTS only on valsea branch
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here

# Valsea STT (required on valsea branch — replaces ElevenLabs STT)
VALSEA_API_KEY=your_valsea_key_here

# ElevenLabs optional overrides
ELEVENLABS_VOICE_ID=Xb7hH8MSUJpSbSDYk0k2
ELEVENLABS_TTS_MODEL=eleven_flash_v2_5

# OpenAI optional overrides
OPENAI_TEXT_MODEL=gpt-4o-mini

# Dev fallback: path to local workflow JSON (used when SUPABASE_URL is not set)
WORKFLOW_PATH=workflows/default.json

# cal.com — required for calendar_booker nodes
# Workflows reference this via {{ secrets.CAL_COM_API_KEY }}
CAL_COM_API_KEY=

# n8n / webhook — set to true to allow http:// and localhost webhook URLs in dev
ALLOW_LOCAL_WEBHOOKS=false

# Call behaviour
AUTO_HANGUP_MS=30000
TTS_TIMEOUT_MS=15000
PORT=8001
MAX_RECORDING_BYTES=15728640
